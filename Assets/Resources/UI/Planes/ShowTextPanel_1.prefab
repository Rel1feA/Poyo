--- !u!114 &2536341519438828824
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7238649750805537525}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 56b2e04b2fd828840937721d2e9944ec, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text_list:
  - "\u66FE\u6709\u4E00\u7247\u68EE\u6797\uFF0C\u90A3\u91CC\u751F\u673A\u76CE\u7136\uFF0C\u4E07\u7269\u548C\u8C10\u3002\n\u76F4\u5230\u4E00\u58F0\u5DE8\u54CD\u6495\u88C2\u4E86\u5929\u7A7A\uFF0C\u4E00\u9053\u8BE1\u5F02\u7684\u7D2B\u8272\u5149\u675F\u523A\u5165\u5927\u5730\u3002\n\u5149\u8292\u6240\u53CA\u4E4B\u5904\uFF0C\u7075\u9B42\u4EFF\u4F5B\u88AB\u77AC\u95F4\u62BD\u79BB\u3002\u98DE\u9E1F\u50F5\u5728\u534A\u7A7A\uFF0C\u8D70\u517D\u5B9A\u5728\u539F\u5730\u2014\u2014\u6240\u6709\u7684\u52A8\u7269\u90FD\u5931\u53BB\u4E86\u7075\u6027\uFF0C\u50CF\u574F\u6389\u7684\u73A9\u5076\uFF0C\u53EA\u4F1A\u91CD\u590D\u7740\u50F5\u786C\u7684\u52A8\u4F5C\u3002"
  - "\u5728\u8FD9\u7247\u88AB\u593A\u53BB\u201C\u58F0\u97F3\u201D\u7684\u68EE\u6797\u91CC\uFF0C\u53EA\u5269\u4E0B\u4E00\u7F15\u5FAE\u5149\uFF1A\u4E00\u53EA\u540D\u53EB\u7075\u9B42\u5154\u7684\u5C0F\u5BB6\u4F19\u3002\u5B83\u62E5\u6709\u4E00\u79CD\u7279\u522B\u7684\u5929\u8D4B\uFF0C\u80FD\u8BA9\u81EA\u5DF1\u7684\u7075\u9B42\u79BB\u5F00\u8EAB\u4F53\uFF0C\u4F4F\u8FDB\u5176\u4ED6\u52A8\u7269\u7684\u8EAF\u58F3\u91CC\uFF0C\u5E76\u63A7\u5236\u5B83\u4EEC\u884C\u52A8\u3002\u8FD9\u4EFD\u72EC\u7279\u7684\u80FD\u529B\uFF0C\u66FE\u8BA9\u5B83\u4E0E\u4F17\u4E0D\u540C\uFF0C\u5982\u4ECA\u5374\u6210\u4E86\u552F\u4E00\u7684\u5E0C\u671B\u3002"
  - "\u73B0\u5728\uFF0C\u5524\u9192\u8FD9\u5EA7\u5BC2\u9759\u68EE\u6797\u7684\u91CD\u4EFB\uFF0C\u843D\u5728\u4E86\u5B83\u7684\u80A9\u4E0A\u3002\u5B83\u6BCF\u4E00\u6B21\u7684\u9644\u8EAB\uFF0C\u90FD\u662F\u89E3\u5F00\u8C1C\u9898\u7684\u5173\u952E\uFF1B\u5B83\u6BCF\u4E00\u6B21\u7684\u524D\u884C\uFF0C\u90FD\u5728\u4E3A\u4E16\u754C\u627E\u56DE\u5931\u843D\u7684\u5FC3\u8DF3\u3002"
  showTextSpeed: 0.1
