  m_Script: {fileID: 11500000, guid: b788a730ec5213841b003921a05d0d4a, type: 3}
  m_Name: D7
  m_EditorClassIdentifier: 
  dialogue_list:
  - content: "\u76EE\u524D\u770B\u6765\u4ED6\u4EEC\u662F\u60F3\u628A\u5C0F\u52A8\u7269\u4EEC\u7684\u7075\u9B42\u5168\u90E8\u6536\u96C6"
    dialogueObject: 0
  - content: "\u7136\u540E\u5EFA\u7ACB\u4E00\u4E2A\u53EA\u6709\u610F\u8BC6\u6CA1\u6709\u8089\u4F53\u7684\u4E16\u754C"
    dialogueObject: 0
  - content: "\u6211\u5B9E\u5728\u65E0\u6CD5\u60F3\u8C61\u90A3\u6837\u7684\u4E16\u754C\u4F1A\u662F\u600E\u6837\u7684"
    dialogueObject: 0
  - content: "\u4F30\u8BA1\u90A3\u65F6\u5019\u6574\u4E2A\u661F\u7403\u5C31\u50CF\u865A\u65E0\u4E00\u6837"
    dialogueObject: 1
  - content: "\u53EA\u6709\u770B\u4E0D\u89C1\u7684\u610F\u8BC6\uFF0C\u6CA1\u6709\u5B9E\u4F53"
    dialogueObject: 1
  - content: "\u4E0D\u8FC7\u4F60\u7684\u51FA\u73B0\uFF0C\u6216\u8BB8\u80FD\u9006\u8F6C\u8FD9\u4E2A\u5C40\u9762"
    dialogueObject: 1
  - content: "\u4E0D\u8FC7\u6211\u53EA\u662F\u4E00\u53EA\u666E\u901A\u7684\u5154\u5B50\uFF0C\u6211\u771F\u7684\u80FD\u505A\u5230\u5417"
    dialogueObject: 0
  - content: "\u4F60\u5E76\u4E0D\u666E\u901A\uFF0C\u4F60\u7684\u7075\u9B42\u63A7\u5236\u80FD\u529B\u5F88\u72EC\u7279"
    dialogueObject: 1
  - content: "\u867D\u7136\u4ED6\u4EEC\u4F1A\u56E0\u6B64\u800C\u66F4\u60F3\u6293\u4F4F\u4F60"
    dialogueObject: 1
  - content: "\u4F46\u662F\u8FD9\u540C\u6837\u4E5F\u662F\u4F60\u5BF9\u4ED8\u4ED6\u4EEC\u7684\u6B66\u5668"
    dialogueObject: 1
  - content: "\u52A0\u6CB9\uFF0C\u7EE7\u7EED\u524D\u8FDB\u5427\uFF01"
    dialogueObject: 1
  id: 7
