  m_Script: {fileID: 11500000, guid: b788a730ec5213841b003921a05d0d4a, type: 3}
  m_Name: D3
  m_EditorClassIdentifier: 
  dialogue_list:
  - content: "\u751F\u6001\u89C2\u6D4B\u65E5\u5FD7\uFF1F\uFF01\u534F\u8BAE\u201C\u65B9\u821F\u201D\u53C8\u662F\u4EC0\u4E48\uFF1F"
    dialogueObject: 0
  - content: "\u96BE\u9053\u5C0F\u52A8\u7269\u4EEC\u7684\u7075\u9B42\u5931\u8E2A\u4E8B\u4EF6\u8DDF\u8FD9\u4E2A\u6709\u5173\uFF1F"
    dialogueObject: 0
  - content: "\u6211\u731C\u5E94\u8BE5\u662F\u7684\uFF0C\u770B\u6765\u8FD9\u4EF6\u4E8B\u60C5\u4E0D\u7B80\u5355"
    dialogueObject: 1
  - content: "\u6211\u521A\u521A\u8FDB\u5165\u5C0F\u8783\u87F9\u7684\u8EAB\u4F53\u91CC\u9762\uFF0C\u611F\u5230\u7A7A\u8361\u8361\u7684\u611F\u89C9"
    dialogueObject: 1
  - content: "\u53EA\u6709\u4E00\u6BB5\u88AB\u5199\u597D\u7684\u751F\u7269\u7A0B\u5E8F\u5728\u64CD\u63A7\u5B83"
    dialogueObject: 1
  - content: "\u6211\u731C\u8FD9\u5C31\u662F\u6240\u8C13\u7684\u201C\u751F\u7269\u62DF\u6001\u201C"
    dialogueObject: 1
  id: 3
