  m_Script: {fileID: 11500000, guid: b788a730ec5213841b003921a05d0d4a, type: 3}
  m_Name: D6
  m_EditorClassIdentifier: 
  dialogue_list:
  - content: "\u770B\u6765\u4ED6\u4EEC\u597D\u50CF\u53D1\u73B0\u4E86\u4F60\u7684\u7279\u6B8A\u80FD\u529B"
    dialogueObject: 1
  - content: "\u554A\uFF1F\uFF01\u90A3\u6211\u4EEC\u7684\u5C0F\u5FC3\u70B9\u4E86"
    dialogueObject: 0
  - content: "\u4E0D\u8FC7\u4F60\u4E5F\u4E0D\u7528\u592A\u62C5\u5FC3\uFF0C\u76EE\u524D\u4ED6\u4EEC\u5E76\u6CA1\u6709\u592A\u5728\u610F"
    dialogueObject: 1
  - content: "\u7EE7\u7EED\u5F80\u524D\u8D70\u5C31\u884C"
    dialogueObject: 1
  - content: "\u5176\u5B9E\u6211\u6709\u4E2A\u95EE\u9898"
    dialogueObject: 0
  - content: "\u4E3A\u4EC0\u4E48\u53EA\u6709\u6211\u6709\u8FD9\u4E2A\u7075\u9B42\u63A7\u5236\u7684\u80FD\u529B\u5462\uFF1F"
    dialogueObject: 0
  - content: "\u8FD9\u4E2A\u95EE\u9898\u6211\u4E5F\u4E0D\u662F\u5F88\u6E05\u695A"
    dialogueObject: 1
  - content: "\u4E0D\u8FC7\u6211\u731C\u8FD9\u4E00\u5207\u90FD\u662F\u5B89\u6392\u597D\u7684\u5427"
    dialogueObject: 1
  - content: "\u6216\u8BB8\u7B54\u6848\u5F88\u5FEB\u5C31\u4F1A\u6D6E\u51FA\u6C34\u9762\u4E86"
    dialogueObject: 1
  id: 6
