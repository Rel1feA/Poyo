  dialogue_list:
  - content: "\u770B\u90A3\u53EA\u6D63\u718A\uFF01\u5B83\u597D\u50CF\u673A\u5668\u4EBA\u4E00\u6837\u6309\u7167\u4E00\u6837\u7684\u7EBF\u8DEF\u6765\u56DE\u8D70\u52A8\uFF01"
    dialogueObject: 0
  - content: "\u5B83\u5E94\u8BE5\u5C31\u50CF\u77F3\u7891\u4E0A\u8BF4\u7684\u4E00\u6837\uFF0C\u88AB\u9884\u8BBE\u4E86\u539F\u59CB\u7684\u884C\u4E3A\uFF0C\u4E00\u76F4\u5FAA\u73AF"
    dialogueObject: 1
  - content: "\u7B49\u7B49\uFF01\u4F60\u770B\u5230\u5B83\u8EAB\u4E0A\u7684\u70B8\u5F39\u4E86\u5417"
    dialogueObject: 1
  - content: "\u6216\u8BB8\u6211\u4EEC\u53EF\u4EE5\u60F3\u529E\u6CD5\u64CD\u63A7\u5B83"
    dialogueObject: 1
  - content: "\u8BA9\u4ED6\u628A\u70B8\u5F39\u4E22\u4E0B\u6765\uFF0C\u70B8\u6389\u524D\u9762\u7684\u788E\u77F3"
    dialogueObject: 1
  id: 5
