  dialogue_list:
  - content: "\u662F\u5C0F\u8783\u87F9\uFF01\u5B83\u600E\u4E48\u56DE\u4E8B\uFF1F\u4E3A\u4EC0\u4E48\u4E00\u76F4\u4E0D\u52A8\uFF1F"
