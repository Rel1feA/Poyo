  m_Script: {fileID: 11500000, guid: b788a730ec5213841b003921a05d0d4a, type: 3}
  m_Name: D1
  m_EditorClassIdentifier: 
  dialogue_list:
  - content: "\u600E\u4E48\u56DE\u4E8B\uFF1F\u521A\u521A\u6574\u4E2A\u68EE\u6797\u90FD\u5728\u6296\u52A8\uFF0C\u6211\u8FD8\u770B\u5230\u4E00\u675F\u5947\u602A\u7684\u5149\u7EBF\uFF1F"
    dialogueObject: 0
  - content: "\u6211\u521A\u521A\u7A81\u7136\u6709\u4E00\u9635\u5947\u602A\u7684\u611F\u89C9\uFF0C\u6211\u597D\u50CF\u88AB\u5F3A\u5236\u62BD\u79BB\u51FA\u4E86\u4F60\u7684\u8EAB\u4F53"
    dialogueObject: 1
  - content: "\u4F46\u597D\u9669\u4F60\u7684\u7075\u9B42\u63A7\u5236\u80FD\u529B\u6BD4\u8F83\u5F3A\uFF0C\u6211\u624D\u6CA1\u6709\u88AB\u6293\u4F4F"
    dialogueObject: 1
  - content: "\u73B0\u5728\u5148\u8BA9\u6211\u6765\u63A2\u6D4B\u4E00\u4E0B\u5468\u56F4\u7684\u60C5\u51B5\u5427"
    dialogueObject: 1
  - content: "\u3002\u3002\u3002\u3002\u3002\u3002"
    dialogueObject: 1
  - content: "\u7CDF\u4E86\uFF01\uFF01\u6211\u611F\u53D7\u4E0D\u5230\u5176\u4ED6\u5C0F\u52A8\u7269\u7684\u7075\u9B42\u4E86\uFF01\uFF01"
    dialogueObject: 1
  - content: "\u4ED6\u4EEC\u7684\u7075\u9B42\u5168\u90FD\u8DD1\u6389\u4E86\uFF0C\u73B0\u5728\u53EA\u6709\u4F60\u80FD\u63A7\u5236\u4ED6\u4EEC\u4E86"
    dialogueObject: 1
  - content: "\u5148\u4E0D\u8BF4\u8FD9\u4E48\u591A\u4E86\uFF0C\u5148\u5F80\u524D\u8D70\u770B\u770B\u5427"
    dialogueObject: 1
  id: 1
